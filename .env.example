# ---- Database ----
# Local (docker compose): the postgres service below.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/docpipeline?schema=public"

# Only needed when DATABASE_URL points at a connection pooler (e.g. Neon's
# `-pooler` host). Migrations run over this instead, because Prisma's migration
# advisory lock is session-scoped and a pooler can leak it — see P1002 in
# scripts/migrate-deploy.sh. Leave unset locally and under docker compose.
# DIRECT_DATABASE_URL="postgresql://...@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ---- API ----
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# ---- Storage ----
STORAGE_PATH=./uploads
MAX_UPLOAD_BYTES=10485760

# ---- Processing ----
MAX_PROCESSING_ATTEMPTS=3
MOCK_PROCESSOR_MODE=random          # random | always_success | always_timeout | always_invalid
MOCK_PROCESSOR_DELAY_MS=1500

# ---- Worker ----
RUN_WORKER_IN_PROCESS=false
WORKER_POLL_INTERVAL_MS=1000
WORKER_CONCURRENCY=2
JOB_LEASE_TIMEOUT_MS=120000
REAPER_INTERVAL_MS=30000

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:4000/api
